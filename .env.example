# cp .env.example .env
# --- Neo4j Database (Local Docker hoặc Neo4j AuraDB) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- Extraction, Generation & Judge (OpenRouter, OpenAI-compatible) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=GraphRAG_vs_FlatRAG_Lab

# Dùng cùng OpenRouter cho LLM-as-a-Judge.
JUDGE_PROVIDER=openrouter
JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct

# Tuỳ chọn fallback nếu không dùng OpenRouter.
GROQ_API_KEY=
GROQ_MODEL=
OPENAI_API_KEY=

# --- Hugging Face Access Token (để stream dataset HackerNoon) ---
HF_TOKEN=hf_...
